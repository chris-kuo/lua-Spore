#!/usr/bin/lua
--
-- lua-Spore : <https://fperrad.frama.io/lua-Spore>
--

local spore
local i = 1
while i <= #arg do
    local v = arg[i]
    if v:sub(1, 2) ~= '--' then
        break
    end
    if v == '--spore' then
        i = i + 1
        spore = arg[i]
    end
    i = i + 1
end
local url = arg[i]
if not url then
    print('Usage: raml2spore [--spore 1.0|1.1] url')
    os.exit(0)
end

local slurp = require'Spore.Protocols'.slurp
local raml = require'Spore.RAML'
local convert = require'Spore.RAML'.convert
local load = require'lyaml'.load
local encode = require'dkjson'.encode

if spore then
    raml.spore = spore
end

local content = slurp(url)
print(encode(convert(load(content))))

